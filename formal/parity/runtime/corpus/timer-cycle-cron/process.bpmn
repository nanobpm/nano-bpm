  <bpmn:process id="parity-timer-cycle-cron" name="Cron timer cycles" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_s_t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_s_t" sourceRef="StartEvent_1" targetRef="Task_Work" />
    <bpmn:serviceTask id="Task_Work" name="Work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="work" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_s_t</bpmn:incoming>
      <bpmn:outgoing>Flow_t_e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_t_e" sourceRef="Task_Work" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_t_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_1" name="0 0/15 * * * ?" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0/15 * * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t1" sourceRef="Timer_1" targetRef="End_T1" />
    <bpmn:endEvent id="End_T1" name="Tick 1">
      <bpmn:incoming>Flow_t1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_2" name="0 0 9-17 * * MON-FRI" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_2_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 9-17 * * MON-FRI</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t2" sourceRef="Timer_2" targetRef="End_T2" />
    <bpmn:endEvent id="End_T2" name="Tick 2">
      <bpmn:incoming>Flow_t2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_3" name="0 0 0 L * ?" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_3_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 L * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t3" sourceRef="Timer_3" targetRef="End_T3" />
    <bpmn:endEvent id="End_T3" name="Tick 3">
      <bpmn:incoming>Flow_t3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_4" name="0 0 12 1W * ?" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_4_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 12 1W * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t4" sourceRef="Timer_4" targetRef="End_T4" />
    <bpmn:endEvent id="End_T4" name="Tick 4">
      <bpmn:incoming>Flow_t4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_5" name="@daily" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">@daily</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t5" sourceRef="Timer_5" targetRef="End_T5" />
    <bpmn:endEvent id="End_T5" name="Tick 5">
      <bpmn:incoming>Flow_t5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_6" name="0 30 6 ? JAN,FEB SUN#1" cancelActivity="false" attachedToRef="Task_Work">
      <bpmn:outgoing>Flow_t6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_6_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 30 6 ? JAN,FEB SUN#1</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_t6" sourceRef="Timer_6" targetRef="End_T6" />
    <bpmn:endEvent id="End_T6" name="Tick 6">
      <bpmn:incoming>Flow_t6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
