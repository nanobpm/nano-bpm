<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_inclusive-gateway-subprocess-scope" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="inclusive-gateway-subprocess-scope" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:subProcess id="sub">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="status" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:startEvent id="sub_start" />
      <bpmn:serviceTask id="work">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="work" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:inclusiveGateway id="gw" default="to_no" />
      <bpmn:endEvent id="yes_end" />
      <bpmn:endEvent id="no_end" />
      <bpmn:sequenceFlow id="f1" sourceRef="sub_start" targetRef="work" />
      <bpmn:sequenceFlow id="f2" sourceRef="work" targetRef="gw" />
      <bpmn:sequenceFlow id="to_yes" sourceRef="gw" targetRef="yes_end">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= status = "done"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="to_no" sourceRef="gw" targetRef="no_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="done" />
    <bpmn:sequenceFlow id="f_in" sourceRef="start" targetRef="sub" />
    <bpmn:sequenceFlow id="f_out" sourceRef="sub" targetRef="done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="inclusive-gateway-subprocess-scope">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_di" bpmnElement="sub" isExpanded="true">
        <dc:Bounds x="240" y="40" width="520" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_start_di" bpmnElement="sub_start">
        <dc:Bounds x="270" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="work_di" bpmnElement="work">
        <dc:Bounds x="340" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="820" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_di" bpmnElement="gw" isMarkerVisible="true">
        <dc:Bounds x="490" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="yes_end_di" bpmnElement="yes_end">
        <dc:Bounds x="640" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="no_end_di" bpmnElement="no_end">
        <dc:Bounds x="640" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="306" y="118" />
        <di:waypoint x="340" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="440" y="118" />
        <di:waypoint x="490" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_yes_di" bpmnElement="to_yes">
        <di:waypoint x="540" y="118" />
        <di:waypoint x="640" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_no_di" bpmnElement="to_no">
        <di:waypoint x="540" y="118" />
        <di:waypoint x="560" y="118" />
        <di:waypoint x="560" y="228" />
        <di:waypoint x="640" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_in_di" bpmnElement="f_in">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="216" y="118" />
        <di:waypoint x="216" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_out_di" bpmnElement="f_out">
        <di:waypoint x="760" y="170" />
        <di:waypoint x="820" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
