<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ExclusiveLoop" targetNamespace="http://nanobpm.io/corpus">
  <bpmn:process id="ExclusiveLoop" isExecutable="true">
    <bpmn:startEvent id="S">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="A"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="X">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="X"/>
    <bpmn:sequenceFlow id="f3" sourceRef="X" targetRef="A">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="X" targetRef="E">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ExclusiveLoop">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="142" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="865" y="60" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_di" bpmnElement="X" isMarkerVisible="true">
        <dc:Bounds x="895" y="295" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E">
        <dc:Bounds x="902" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="178" y="100"/>
        <di:waypoint x="865" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="975" y="100"/>
        <di:waypoint x="1015" y="100"/>
        <di:waypoint x="1015" y="375"/>
        <di:waypoint x="825" y="375"/>
        <di:waypoint x="825" y="320"/>
        <di:waypoint x="895" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="945" y="320"/>
        <di:waypoint x="1015" y="320"/>
        <di:waypoint x="1015" y="375"/>
        <di:waypoint x="825" y="375"/>
        <di:waypoint x="825" y="100"/>
        <di:waypoint x="865" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="920" y="345"/>
        <di:waypoint x="920" y="375"/>
        <di:waypoint x="920" y="375"/>
        <di:waypoint x="920" y="228"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
