<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ParallelDiamond" targetNamespace="http://nanobpm.io/corpus">
  <bpmn:process id="ParallelDiamond" isExecutable="true">
    <bpmn:startEvent id="S">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="P1">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="A">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="A"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="B"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P2">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="P1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="P1" targetRef="A"/>
    <bpmn:sequenceFlow id="f3" sourceRef="P1" targetRef="B"/>
    <bpmn:sequenceFlow id="f4" sourceRef="A" targetRef="P2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="B" targetRef="P2"/>
    <bpmn:sequenceFlow id="f6" sourceRef="P2" targetRef="E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ParallelDiamond">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="142" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_di" bpmnElement="P1">
        <dc:Bounds x="325" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="485" y="60" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_di" bpmnElement="B">
        <dc:Bounds x="485" y="170" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_di" bpmnElement="P2">
        <dc:Bounds x="705" y="185" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E">
        <dc:Bounds x="902" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="178" y="100"/>
        <di:waypoint x="325" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="375" y="100"/>
        <di:waypoint x="485" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="375" y="100"/>
        <di:waypoint x="467" y="100"/>
        <di:waypoint x="467" y="210"/>
        <di:waypoint x="485" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="595" y="100"/>
        <di:waypoint x="687" y="100"/>
        <di:waypoint x="687" y="210"/>
        <di:waypoint x="705" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="595" y="210"/>
        <di:waypoint x="705" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="755" y="210"/>
        <di:waypoint x="902" y="210"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
