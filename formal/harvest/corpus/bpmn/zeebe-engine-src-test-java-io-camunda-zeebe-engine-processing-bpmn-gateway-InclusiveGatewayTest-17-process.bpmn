        <ns0:taskDefinition type="type"/>
      </extensionElements>
      <incoming>sequenceFlow_7</incoming>
      <outgoing>sequenceFlow_8</outgoing>
    </serviceTask>
    <sequenceFlow id="sequenceFlow_7" sourceRef="parallel" targetRef="task-3"/>
    <sequenceFlow id="sequenceFlow_8" sourceRef="task-3" targetRef="exclusive"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
