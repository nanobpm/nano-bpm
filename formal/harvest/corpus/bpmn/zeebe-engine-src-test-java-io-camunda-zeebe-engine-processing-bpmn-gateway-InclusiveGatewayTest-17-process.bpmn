      <outgoing>sequenceFlow_2</outgoing>
      <outgoing>sequenceFlow_3</outgoing>
    </parallelGateway>
    <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent_1" targetRef="fork"/>
