      <outgoing>sequenceFlow_1</outgoing>
    </startEvent>
    <callActivity id="C" name="C">
      <extensionElements>
        <ns0:calledElement processId="childProcessId"/>
      </extensionElements>
      <incoming>sequenceFlow_1</incoming>
      <outgoing>to_end_after_C</outgoing>
