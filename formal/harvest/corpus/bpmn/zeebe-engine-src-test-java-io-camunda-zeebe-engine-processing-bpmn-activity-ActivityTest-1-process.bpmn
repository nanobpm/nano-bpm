      <outgoing>sequenceFlow_1</outgoing>
    </startEvent>
    <serviceTask id="task" name="task">
      <extensionElements>
        <ns0:taskDefinition type="type"/>
      </extensionElements>
      <incoming>sequenceFlow_1</incoming>
      <outgoing>sequenceFlow_2</outgoing>
    </serviceTask>
    <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent_1" targetRef="task"/>
