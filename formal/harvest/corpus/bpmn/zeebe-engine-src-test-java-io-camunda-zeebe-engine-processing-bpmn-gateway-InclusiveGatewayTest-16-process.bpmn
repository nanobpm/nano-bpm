<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" exporter="Zeebe BPMN Model" exporterVersion="8.10.8" id="definitions_1" xmlns:modeler="http://camunda.org/schema/modeler/1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.8" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <!-- zeebe-cells: element:ExclusiveGateway element:InclusiveGateway element:StartEvent element:Task -->
  <process id="process" isExecutable="true">
    <startEvent id="start" name="start">
      <outgoing>sequenceFlow_1</outgoing>
    </startEvent>
    <exclusiveGateway id="fork" name="fork">
      <incoming>sequenceFlow_1</incoming>
      <outgoing>sequenceFlow_2</outgoing>
      <outgoing>sequenceFlow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow_1" sourceRef="start" targetRef="fork"/>
    <sequenceFlow id="sequenceFlow_2" sourceRef="fork" targetRef="task1">
      <conditionExpression id="conditionExpression_1">=a &gt;= 0</conditionExpression>
    </sequenceFlow>
    <task id="task1" name="task1">
      <incoming>sequenceFlow_2</incoming>
      <outgoing>sequenceFlow_4</outgoing>
    </task>
    <inclusiveGateway id="join" name="join">
      <incoming>sequenceFlow_4</incoming>
      <incoming>sequenceFlow_5</incoming>
      <outgoing>sequenceFlow_6</outgoing>
      <outgoing>sequenceFlow_7</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="sequenceFlow_4" sourceRef="task1" targetRef="join"/>
    <sequenceFlow id="sequenceFlow_3" sourceRef="fork" targetRef="task2">
      <conditionExpression id="conditionExpression_2">=a &lt; 0</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="task2">
      <incoming>sequenceFlow_3</incoming>
      <outgoing>sequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow_5" sourceRef="task2" targetRef="join"/>
    <sequenceFlow id="sequenceFlow_6" sourceRef="join" targetRef="task3">
      <conditionExpression id="conditionExpression_3">=b &gt; 0</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="task3">
      <incoming>sequenceFlow_6</incoming>
    </task>
    <sequenceFlow id="sequenceFlow_7" sourceRef="join" targetRef="task4">
      <conditionExpression id="conditionExpression_4">=b &gt; 5</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="task4">
      <incoming>sequenceFlow_7</incoming>
    </task>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="process" id="BPMNPlane_1">
