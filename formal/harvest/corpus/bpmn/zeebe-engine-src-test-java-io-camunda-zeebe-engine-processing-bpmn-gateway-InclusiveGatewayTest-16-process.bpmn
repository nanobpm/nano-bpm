      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="sequenceFlow_3" id="BPMNEdge_4">
        <di:waypoint x="211.0" y="143.0"/>
        <di:waypoint x="211.0" y="248.0"/>
        <di:waypoint x="286.0" y="248.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="sequenceFlow_5" id="BPMNEdge_5">
        <di:waypoint x="386.0" y="248.0"/>
        <di:waypoint x="436.0" y="118.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape bpmnElement="task3" id="BPMNShape_6">
        <dc:Bounds height="80.0" width="100.0" x="536.0" y="78.0"/>
