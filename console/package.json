{
  "name": "nanobpmn-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web console for the self-contained single-node nanobpmn distribution: cluster/topology view, BPMN modeler, process-instance explorer, and embedded workers.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-ts",
    "typecheck": "npm run gen:api && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "build:assets": "npm run gen:api && node scripts/copy-swagger.mjs && node scripts/copy-asyncapi.mjs && node scripts/build-docs.mjs && node scripts/build-whitepaper.mjs && node scripts/build-changelog.mjs && tsc",
    "build": "npm run build:assets && vite build && node scripts/precompress.mjs dist",
    "build:observe": "npm run build:assets && VITE_CONSOLE_PROFILE=observe vite build --outDir dist-observe --emptyOutDir && node scripts/precompress.mjs dist-observe",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bpmn-io/extract-process-variables": "^2.2.1",
    "@bpmn-io/form-js": "^1.21.3",
    "@bpmn-io/properties-panel": "^3.44.1",
    "@camunda/zeebe-element-templates-json-schema": "0.44.0",
    "@craftjs/core": "^0.2.12",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@nanobpm/bojtos-kit": "^0.11.0",
    "@nanobpm/bojtos-react": "^0.11.0",
    "@nanobpm/nano-app-schema": "file:../spec-app",
    "@tanstack/react-query": "^5.59.0",
    "@typescript/ata": "^0.9.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bpmn-js": "^17.11.1",
    "bpmn-js-element-templates": "^2.27.0",
    "bpmn-js-properties-panel": "^5.59.0",
    "camunda-bpmn-js-behaviors": "^1.18.0",
    "dmn-js": "^17.8.1",
    "driver.js": "^1.8.0",
    "markdown-it": "^14.2.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zeebe-bpmn-moddle": "^1.15.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@hey-api/json-schema-ref-parser": "^1.4.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "js-yaml": "^4.3.0",
    "prettier": "3.9.6",
    "swagger-ui-dist": "^5.32.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
