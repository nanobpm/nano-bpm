{
  "name": "@nanobpm/engine-wasm",
  "version": "0.11.0",
  "description": "The nanobpmn engine (engine-core) compiled to WebAssembly for in-browser BPMN execution: deploy a diagram, start instances, activate/complete jobs, and read live snapshots/traces. Published as two subpath entrypoints — a lean baseline engine (default) and a read-model engine (the gateway's C8-style REST read surface). The substrate for the Bojtos demo framework (ADR 0043) and the console test-run panel.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanobpm/nano-bpm",
    "directory": "engine-wasm/pkg"
  },
  "main": "./lean/nanobpmn_engine.js",
  "module": "./lean/nanobpmn_engine.js",
  "types": "./lean/nanobpmn_engine.d.ts",
  "exports": {
    ".": {
      "types": "./lean/nanobpmn_engine.d.ts",
      "default": "./lean/nanobpmn_engine.js"
    },
    "./readmodel": {
      "types": "./readmodel/nanobpmn_engine.d.ts",
      "default": "./readmodel/nanobpmn_engine.js"
    },
    "./readmodel-types": {
      "types": "./readmodel-types/index.d.ts",
      "default": "./readmodel-types/index.js"
    },
    "./lean/nanobpmn_engine_bg.wasm": "./lean/nanobpmn_engine_bg.wasm",
    "./readmodel/nanobpmn_engine_bg.wasm": "./readmodel/nanobpmn_engine_bg.wasm"
  },
  "files": [
    "lean/nanobpmn_engine.js",
    "lean/nanobpmn_engine.d.ts",
    "lean/nanobpmn_engine_bg.wasm",
    "lean/nanobpmn_engine_bg.wasm.d.ts",
    "readmodel/nanobpmn_engine.js",
    "readmodel/nanobpmn_engine.d.ts",
    "readmodel/nanobpmn_engine_bg.wasm",
    "readmodel/nanobpmn_engine_bg.wasm.d.ts",
    "readmodel-types/index.js",
    "readmodel-types/index.d.ts",
    "readmodel-types/types.gen.d.ts",
    "README.md"
  ],
  "sideEffects": [
    "./snippets/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
