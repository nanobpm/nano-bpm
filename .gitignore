# Build artifacts produced by scripts/generate.sh — regenerate with `make generate`.
build/
generated/
/generated
# Generated console API crate (scripts/generate-console.sh) — regenerate with `make generate`.
generated-console/
/generated-console
target/

# CI-generated artifact tree for the FFI wasm (regenerated with `make engine-wasm-ffi-dist`).
dist/

# The @nanobpm/engine-wasm package (wasm-pack output, both `lean` and `readmodel`
# variants) — a build output, never committed (#668). Build it with
# `make console-wasm`; CI builds it from the PR's own source via
# .github/actions/engine-wasm-pkg. The hand-maintained manifest template
# engine-wasm/pkg.package.json is a sibling file and stays tracked.
/engine-wasm/pkg/

# Generated stub trait implementations (produced by scripts/gen-stub-server.py).
server/src/stub_impls.rs

# Spec-generated response-contract bundle (produced by
# scripts/gen-response-contract.py; issue #1011). Regenerated by `make generate`.
server/src/response_contract_schema.json

# Persistence journals written by the server (set via NANOBPMN_JOURNAL).
*.journal

# Runtime data directory (NANOBPMN_DATA_DIR: read-model DB + journal).
.data/

# processos runtime data directory (read-model DB + journal + authored models).
.processos-data/

# processos Python venv for the optional run_python analysis tool (machine-local).
processos/.venv/

# uv-managed Python environment for the build-time codegen helpers (see
# pyproject.toml). The lockfile (uv.lock) IS committed for reproducibility.
.venv/

# Console workspace (NANOBPMN_WORKSPACE_DIR: authoring source of truth — BPMN
# models + worker code). User content, not committed.
nanobpm-workspace/

.processos-nano-data/
nohup.out

# Generated nanobpm.io Pages site (built by website/build.mjs)
website/_site/
